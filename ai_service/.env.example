# Copy this file to .env and fill in real values for your machine.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Shared secret Django must send as the X-Internal-Api-Key header — must
# match AI_SERVICE_INTERNAL_KEY in backend/.env. Leave blank for local dev
# without auth between the two services; set both in any shared/deployed environment.
AI_SERVICE_INTERNAL_KEY=
