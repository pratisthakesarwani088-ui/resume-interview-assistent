# Copy this file to .env and fill in real values for your machine.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------
# Set to True to use sqlite instead of Postgres (handy for a quick local run)
USE_SQLITE=False

# Option A: individual vars (used by docker-compose and plain local setup)
DB_NAME=interview_assistant
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Option B: a single connection string — takes priority over the DB_* vars
# above when set. This is what Render's managed Postgres provides
# automatically, so you won't normally set this by hand locally.
DATABASE_URL=
DATABASE_SSL_REQUIRE=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Module 2: max accepted resume PDF size, in megabytes
MAX_RESUME_SIZE_MB=5

# --- Module 4: RAG / ChromaDB ------------------------------------------
# Defaults to <project>/chroma_data if unset (local persistent directory —
# what plain local development uses). Set CHROMA_HTTP_HOST to connect to a
# networked Chroma server instead (docker-compose and Render both set this).
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION_NAME=resume_chunks
CHROMA_HTTP_HOST=
CHROMA_HTTP_PORT=8000

# --- Module 8: FastAPI AI service ---------------------------------------
# Where Django sends Gemini/embedding requests. Gemini's own API key lives
# in the AI service's environment now (ai_service/.env.example), not here.
AI_SERVICE_URL=http://localhost:8001
# Shared secret the AI service checks on every request — must match
# AI_SERVICE_INTERNAL_KEY in ai_service/.env. Leave both blank for local dev
# without auth between the two services; set both in any shared/deployed environment.
AI_SERVICE_INTERNAL_KEY=

# --- Module 8: production security (only takes effect when DJANGO_DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
